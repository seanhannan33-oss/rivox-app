# Copy to .env and fill in. Never commit .env.
PORT=8787

# Long random string. Signs sign-in codes and session tokens.
SESSION_SECRET=

# Loop Subscriptions Admin API. Generate the token in the Loop dashboard.
LOOP_API_TOKEN=
# Path and header match Loop's docs (developer.loopwork.co). Response shape still to confirm.
LOOP_API_BASE=https://api.loopsubscriptions.com/admin/2026-04
LOOP_AUTH_HEADER=X-Loop-Token
# {email} is replaced with the URL-encoded customer email.
LOOP_SUBSCRIPTIONS_BY_EMAIL_PATH=/customer/{email}/subscription

# Shared secret Loop sends with each webhook (header name below).
LOOP_WEBHOOK_SECRET=
LOOP_WEBHOOK_SECRET_HEADER=X-Loop-Webhook-Secret

# Comma-separated Shopify product IDs that count as each subscription.
NO_CURFEW_PRODUCT_IDS=
POUCH_PRODUCT_IDS=

# "resend" emails the codes. "console" prints them to the server log (testing only).
EMAIL_PROVIDER=console
# Needed for resend. EMAIL_FROM must be on a domain verified in Resend, e.g. Rivox Labs <login@rivoxlabs.com>
RESEND_API_KEY=
EMAIL_FROM=

# Postgres connection string. Leave empty to keep everything in memory (testing only).
DATABASE_URL=

# Unlocks the admin page at /admin for posting drops. 32+ random characters. Leave empty to switch admin off.
ADMIN_TOKEN=
# Hosts a drop's button may link to, comma-separated.
DROP_LINK_HOSTS=rivoxlabs.com

# Meal photos. Leave the key empty to switch the feature off.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5
# Photos one member can send per day. Each one costs a little.
PHOTO_DAILY_LIMIT=12

# Sign-in limits. TRUSTED_PROXY_HOPS is how many proxies sit in front of the server (1 on most hosts).
TRUSTED_PROXY_HOPS=1
CODE_DAILY_LIMIT=10

# Push notifications go through Expo. Leave empty unless "enhanced security" is on for the Expo project.
EXPO_ACCESS_TOKEN=

# Points and rewards. Points add up without any of this. Redeeming needs the Shopify key.
POINTS_PER_CHECKIN=1
FIVE_OFF_COST=60
FREE_TIN_COST=90
# One-time bonus the first time a streak reaches a length. Leave empty to switch bonuses off.
STREAK_BONUS=7:2,30:3,60:5,90:10
# Shopify Admin API. The token needs write_discounts, read_customers and read_products.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
SITE_URL=https://rivoxlabs.com
# Products a free tin can be claimed from, and where the link lands.
REWARD_TIN_PRODUCT_IDS=
REWARD_TIN_PATH=/collections/all
