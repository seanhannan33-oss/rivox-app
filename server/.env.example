# Copy to .env and fill in. Never commit .env.
PORT=8787

# Long random string. Signs sign-in codes and session tokens.
SESSION_SECRET=

# Loop Subscriptions Admin API. Generate the token in the Loop dashboard.
LOOP_API_TOKEN=
# UNVERIFIED defaults. Confirm all three against https://developer.loopwork.co before going live.
LOOP_API_BASE=https://api.loopsubscriptions.com/admin/2023-10
LOOP_AUTH_HEADER=X-Loop-Token
# {email} is replaced with the URL-encoded customer email.
LOOP_SUBSCRIPTIONS_BY_EMAIL_PATH=/customer/{email}/subscription

# Shared secret Loop sends with each webhook (header name below).
LOOP_WEBHOOK_SECRET=
LOOP_WEBHOOK_SECRET_HEADER=X-Loop-Webhook-Secret

# Comma-separated Shopify product IDs that count as each subscription.
NO_CURFEW_PRODUCT_IDS=
POUCH_PRODUCT_IDS=

# "console" prints sign-in codes to the server log (development only).
EMAIL_PROVIDER=console
EMAIL_FROM=
